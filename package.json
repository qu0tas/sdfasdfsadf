{
  "name": "hollow-sun",
  "private": true,
  "version": "1.0.0",
  "description": "Two browser games: Hollow Sun (3D first-person shooter) and Hypnagogia (2D pixel-art roguelike), built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"hypnagogia/tests/*.test.js\"",
    "art": "node hypnagogia/tools/art/characters.mjs && node hypnagogia/tools/art/world.mjs"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
